@model StockFlow.Application.DTOs.ReportDto
@{ ViewData["Title"] = "Reports"; }

<div class="view-container">
  <div class="page-head">
    <div><h1 class="page-title">Reports</h1><p class="page-sub">Analytics & market intelligence (CF_11)</p></div>
    <div style="display:flex;gap:8px">
      <a asp-controller="Reports" asp-action="ExportCsv" asp-route-type="volume" class="btn-action secondary">↓ Volume CSV</a>
      <a asp-controller="Reports" asp-action="ExportCsv" asp-route-type="activity" class="btn-action secondary">↓ Activity CSV</a>
      <a asp-controller="Reports" asp-action="ExportCsv" asp-route-type="transactions" class="btn-action secondary">↓ Trades CSV</a>
    </div>
  </div>

  <div class="grid-2 mb-lg">
    <!-- Volume chart -->
    <div class="report-card">
      <div class="report-title">Trading Volume by Stock</div>
      <div class="chart-wrap" style="height:220px">
        <canvas id="volChart" role="img" aria-label="Trading volume by stock">Volume data</canvas>
      </div>
    </div>

    <!-- User activity -->
    <div class="report-card">
      <div class="report-title">User Activity</div>
      <div class="tbl-wrap" style="border:none">
        <table>
          <thead><tr><th>User</th><th>Trades</th><th>Total Traded</th><th>Last Active</th></tr></thead>
          <tbody>
            @foreach (var u in Model.UserActivity)
            {
              <tr>
                <td>@u.UserName <span style="font-size:11px;color:var(--text3)">(@u.FullName)</span></td>
                <td class="mono">@u.TradeCount</td>
                <td class="price-cell">$@u.TotalTraded.ToString("N2")</td>
                <td class="mono" style="font-size:11px;color:var(--text2)">@(u.LastActive == default ? "Never" : u.LastActive.ToString("yyyy-MM-dd HH:mm"))</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Volume table -->
  <div class="report-card mb-lg">
    <div class="report-title">Stock Volume Report</div>
    <div class="tbl-wrap" style="border:none">
      <table>
        <thead><tr><th>Ticker</th><th>Company</th><th>Buy Volume</th><th>Sell Volume</th><th>Total Value</th></tr></thead>
        <tbody>
          @foreach (var v in Model.VolumeByStock)
          {
            <tr>
              <td class="ticker">@v.Ticker</td>
              <td>@v.CompanyName</td>
              <td class="mono pos">@v.TotalBuyVolume.ToString("N0")</td>
              <td class="mono neg">@v.TotalSellVolume.ToString("N0")</td>
              <td class="price-cell">$@v.TotalValue.ToString("N2")</td>
            </tr>
          }
          @if (!Model.VolumeByStock.Any())
          {
            <tr><td colspan="5" style="text-align:center;padding:2rem;color:var(--text3)">No trades recorded yet.</td></tr>
          }
        </tbody>
      </table>
    </div>
  </div>

  <!-- All transactions -->
  <div class="report-card">
    <div class="report-title">All Transactions (Admin view)</div>
    <div class="tbl-wrap" style="border:none">
      <table>
        <thead><tr><th>Time</th><th>Type</th><th>Ticker</th><th>Qty</th><th>Price</th><th>Total</th><th>Fingerprint</th></tr></thead>
        <tbody>
          @foreach (var t in Model.AllTransactions.Take(50))
          {
            <tr>
              <td class="mono" style="font-size:11px;color:var(--text2)">@t.ExecutedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
              <td><span class="log-type lt-@t.Type.ToLower()">@t.Type.ToUpper()</span></td>
              <td class="ticker">@t.Ticker</td>
              <td class="mono">@t.Quantity</td>
              <td class="price-cell">$@t.PricePerShare.ToString("F2")</td>
              <td class="price-cell">$@t.TotalAmount.ToString("F2")</td>
              <td><span class="fingerprint-tag">@t.Fingerprint</span></td>
            </tr>
          }
          @if (!Model.AllTransactions.Any())
          {
            <tr><td colspan="7" style="text-align:center;padding:2rem;color:var(--text3)">No transactions.</td></tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
const volData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VolumeByStock.Select(v => new { v.Ticker, v.TotalBuyVolume, v.TotalSellVolume })));
const colors = ['#4ade80','#22d3ee','#a78bfa','#fbbf24','#f87171','#60a5fa'];
new Chart(document.getElementById('volChart'), {
  type: 'bar',
  data: {
    labels: volData.map(v => v.ticker),
    datasets: [
      { label: 'Buy', data: volData.map(v => v.totalBuyVolume), backgroundColor: '#4ade80', borderRadius: 4 },
      { label: 'Sell', data: volData.map(v => v.totalSellVolume), backgroundColor: '#f87171', borderRadius: 4 }
    ]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    plugins: { legend: { labels: { color: '#8b90a0', font: { size: 11 } } } },
    scales: {
      x: { ticks: { color: '#555b6e', font: { size: 10 } }, grid: { display: false } },
      y: { ticks: { color: '#555b6e', font: { size: 10 } }, grid: { color: 'rgba(255,255,255,0.04)' } }
    }
  }
});
</script>
}
