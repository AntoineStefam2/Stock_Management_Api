@model StockFlow.Application.DTOs.RegisterDto
@{ ViewData["Title"] = "Register"; Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Register — StockFlow</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Fraunces:wght@600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/css/stockflow.css" />
</head>
<body class="auth-body">
  <div class="auth-brand">
    <div class="auth-logo">Stock<span>Flow</span></div>
    <div class="auth-subtitle">Create your trading account (CF_6)</div>
  </div>

  <div class="auth-card">
    <div class="auth-tabs">
      <a asp-action="Login" class="auth-tab">Sign In</a>
      <span class="auth-tab active">Register</span>
    </div>

    <div asp-validation-summary="All" class="auth-error @(!ViewContext.ModelState.IsValid ? "auth-err-show" : "")"></div>

    <form asp-action="Register" method="post">
      @Html.AntiForgeryToken()

      <div class="field">
        <label>Full Name</label>
        <input asp-for="FullName" class="form-input" placeholder="Jane Smith" />
        <span asp-validation-for="FullName" class="field-error"></span>
      </div>

      <div class="field">
        <label>Username</label>
        <input asp-for="UserName" class="form-input" placeholder="janesmith" autocomplete="username" />
        <span asp-validation-for="UserName" class="field-error"></span>
      </div>

      <div class="field">
        <label>Email</label>
        <input asp-for="Email" type="email" class="form-input" placeholder="jane@example.com" />
        <span asp-validation-for="Email" class="field-error"></span>
      </div>

      <div class="field">
        <label>Password</label>
        <input asp-for="Password" type="password" class="form-input" placeholder="••••••" autocomplete="new-password" />
        <span asp-validation-for="Password" class="field-error"></span>
      </div>

      <div class="field">
        <label>Initial Deposit ($)</label>
        <input asp-for="InitialDeposit" type="number" class="form-input" value="10000" min="100" step="100" />
        <span asp-validation-for="InitialDeposit" class="field-error"></span>
      </div>

      <button type="submit" class="btn-primary">Create Account →</button>
    </form>

    <div class="auth-hint">Already have an account? <a asp-action="Login" style="color:var(--accent2)">Sign in</a></div>
  </div>
</body>
</html>
